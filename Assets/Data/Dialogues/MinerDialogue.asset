  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c234f20efd360eb45b89a7d3a2835e3e, type: 3}
  m_Name: MinerDialogue
  m_EditorClassIdentifier: Main::DialogueObject
  dialogueLines:
  - text: WAAAAAAA, how did you get here?
    speakerName: Miner
    dialogueBoxColor: {r: 1, g: 0.8705883, b: 0.6784314, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: -5805635871556436518, guid: 6b9f542dd340d2d48bc8b6e9cb489d01, type: 3}
    choices:
    - choiceText: I walked here...
      choiceType: 0
      choiceQuality: 1
      nextDialogue: {fileID: 0}
    - choiceText: Don't know
      choiceType: 0
      choiceQuality: 2
      nextDialogue: {fileID: 0}
    - choiceText: I blew up rocks
      choiceType: 0
      choiceQuality: 0
      nextDialogue: {fileID: 0}
  - text: Ohh well, since your here then. Could you help me fix my bridge?
    speakerName: Miner
    dialogueBoxColor: {r: 1, g: 0.8705883, b: 0.6784314, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: -5805635871556436518, guid: 6b9f542dd340d2d48bc8b6e9cb489d01, type: 3}
    choices:
    - choiceText: Umm sure but i need to get out of here too
      choiceType: 0
      choiceQuality: 0
      nextDialogue: {fileID: 0}
  - text: Why? Don't you like it here?
    speakerName: Miner
    dialogueBoxColor: {r: 1, g: 0.8705883, b: 0.6784314, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: -5805635871556436518, guid: 6b9f542dd340d2d48bc8b6e9cb489d01, type: 3}
    choices:
    - choiceText: Yes, but..
      choiceType: 0
      choiceQuality: 0
      nextDialogue: {fileID: 0}
  - text: 'I see... but thats great because the level to activate the elevator is
      in the storage area after the bridge. '
    speakerName: Miner
    dialogueBoxColor: {r: 1, g: 0.8705883, b: 0.6784314, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: -5805635871556436518, guid: 6b9f542dd340d2d48bc8b6e9cb489d01, type: 3}
    choices:
    - choiceText: Ok then, I'll help
      choiceType: 0
      choiceQuality: 0
      nextDialogue: {fileID: 0}
  - text: 'Nice! Here is some TnT to blow up the rocks in front of the bridge. '
    speakerName: Miner
    dialogueBoxColor: {r: 1, g: 0.8705883, b: 0.6784314, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: -5805635871556436518, guid: 6b9f542dd340d2d48bc8b6e9cb489d01, type: 3}
    choices:
    - choiceText: Ok then, I'll help
      choiceType: 0
      choiceQuality: 0
      nextDialogue: {fileID: 0}
  quest: {fileID: 0}
  questInProgressIndex: 0
  questCompletedIndex: 0
  initialDialogueEndIndex: 0
