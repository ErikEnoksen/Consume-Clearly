  m_Script: {fileID: 11500000, guid: c234f20efd360eb45b89a7d3a2835e3e, type: 3}
  m_Name: MentorDialogue_Welcome
  m_EditorClassIdentifier: Main::DialogueObject
  dialogueLines:
  - text: 'Hello, there young one. Welcomes to the mines! '
    speakerName: Mentor
    dialogueBoxColor: {r: 0.9607844, g: 0.8705883, b: 0.7019608, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: 0}
    choices: []
  - text: "You must have fallen really far to end up here, and already breaking elevators
      I see. Hmmm, I know the miner has something in the storage area to fix it but
      I haven\u2019t seen him for days. He should be somewhere in the mines. Why
      don\u2019t you go look for him then you can fix the elevator and get out of
      here. You dont want to get stuck here\u2026. believe me. Go on, I don\u2019t
      have all day."
    speakerName: Mentor
    dialogueBoxColor: {r: 0.9607844, g: 0.8705883, b: 0.7019608, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: 0}
    choices: []
  - text: " Hmmm, I know the miner has something in the storage area to fix it but
      I haven\u2019t seen him for days."
    speakerName: Mentor
