  m_Script: {fileID: 11500000, guid: c234f20efd360eb45b89a7d3a2835e3e, type: 3}
  m_Name: Intro-Peperbus-Mentor
  m_EditorClassIdentifier: Main::DialogueObject
  dialogueLines:
  - text: 'Well hello again. Welcome to the Peperbus! '
    speakerName: Mentor
    dialogueBoxColor: {r: 0.85098046, g: 0.85098046, b: 0.85098046, a: 0}
    textColor: {r: 0, g: 0, b: 0, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices: []
  - text: 'As you can see it is kept in good condition but reaching the top is quite
      difficult. '
    speakerName: Mentor
    dialogueBoxColor: {r: 0.85098046, g: 0.85098046, b: 0.85098046, a: 0}
    textColor: {r: 0, g: 0, b: 0, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices: []
  - text: 'Making it difficult to maintain the clocktower. So for a while now it
      has been broken. '
    speakerName: Mentor
    dialogueBoxColor: {r: 0.85098046, g: 0.85098046, b: 0.85098046, a: 0}
    textColor: {r: 0, g: 0, b: 0, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices: []
  - text: 'If you end up add the top why don''t you try fixing the bell up there.
      It would mean a lot to the community. '
    speakerName: Mentor
    dialogueBoxColor: {r: 0.85098046, g: 0.85098046, b: 0.85098046, a: 0}
    textColor: {r: 0, g: 0, b: 0, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices:
    - choiceText: Okay
      choiceType: 1
      choiceQuality: 0
      nextDialogue: {fileID: 0}
    - choiceText: Not right now
      choiceType: 3
      choiceQuality: 0
      nextDialogue: {fileID: 0}
  quest: {fileID: 11400000, guid: bd925ad4f1955e64db6b2f7cc15326a2, type: 2}
  questInProgressIndex: 0
  questCompletedIndex: 0
  initialDialogueEndIndex: 0
