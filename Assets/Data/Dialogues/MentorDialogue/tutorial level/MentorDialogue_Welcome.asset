  m_Script: {fileID: 11500000, guid: c234f20efd360eb45b89a7d3a2835e3e, type: 3}
  m_Name: MentorDialogue_Welcome
  m_EditorClassIdentifier: Main::DialogueObject
  dialogueLines:
  - text: 'Hello, there young one. Welcomes to the mines! '
    speakerName: Mentor
    dialogueBoxColor: {r: 0.8470589, g: 0.8470589, b: 0.8470589, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices: []
  - text: 'You must have fallen really far to end up here, and already breaking elevators
      I see. '
    speakerName: Mentor
    dialogueBoxColor: {r: 0.85098046, g: 0.85098046, b: 0.85098046, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices: []
  - text: " Hmmm, I know the miner has something in the storage area to fix it but
      I haven\u2019t seen him for days."
    speakerName: Mentor
    dialogueBoxColor: {r: 0.85098046, g: 0.85098046, b: 0.85098046, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices: []
  - text: "He should be somewhere in the mines. Why don\u2019t you go look for him
      then you can fix the elevator and get out of here."
    speakerName: Mentor
    dialogueBoxColor: {r: 0.85098046, g: 0.85098046, b: 0.85098046, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices: []
  - text: "You dont want to get stuck here\u2026. believe me. "
    speakerName: Mentor
    dialogueBoxColor: {r: 0.85098046, g: 0.85098046, b: 0.85098046, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices:
    - choiceText: Okay, I'll do that
      choiceType: 1
      choiceQuality: 1
      nextDialogue: {fileID: 0}
    - choiceText: ...
      choiceType: 0
      choiceQuality: 1
      nextDialogue: {fileID: 0}
  - text: "Go on, I don\u2019t have all day."
    speakerName: Mentor
    dialogueBoxColor: {r: 0.85098046, g: 0.85098046, b: 0.85098046, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: 930703914476913107, guid: aa3c29b2e7f71d14199c57505fab8e4e, type: 3}
    choices: []
  quest: {fileID: 11400000, guid: bd925ad4f1955e64db6b2f7cc15326a2, type: 2}
