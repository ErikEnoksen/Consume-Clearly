  dialogueLines:
  - text: The machine said 'almost.' That's basically a yes. That's a verbal contract.
    speakerName: 'Gary '
    dialogueBoxColor: {r: 0.8, g: 0.8, b: 0.8, a: 1}
    textColor: {r: 0.1, g: 0.1, b: 0.1, a: 1}
    dialogueBoxSprite: {fileID: 372315781598215182, guid: 60cb56875e5540144a2573ed6d4bd34d, type: 3}
    speakerPortrait: {fileID: -4088442099895833191, guid: f20bb20e6371833408781f2c9f43cbdb, type: 3}
    choices:
    - choiceText: That's not how almost works.
      choiceType: 0
      choiceQuality: 1
      nextDialogue: {fileID: 11400000, guid: e43a0752e80a63e4588217f001c777cf, type: 2}
    - choiceText: I think you should leave.
      choiceType: 0
      choiceQuality: 2
